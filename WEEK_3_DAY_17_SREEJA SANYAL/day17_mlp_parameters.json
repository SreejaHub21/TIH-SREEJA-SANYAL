{
    "model": "Small ANN / MLP",
    "hidden_layers": [
        64,
        32
    ],
    "activation": "relu",
    "solver": "adam",
    "alpha": 0.001,
    "learning_rate_init": 0.001,
    "max_iter": 100,
    "early_stopping": true,
    "validation_fraction": 0.15,
    "n_iter_no_change": 10,
    "random_state": 42,
    "features": [
        "Voltage",
        "Current",
        "Temperature",
        "Elapsed Time",
        "Cycle",
        "WhAccu",
        "Power"
    ],
    "targets": [
        "SOC",
        "Remaining Charging Time"
    ]
}